    },
    {
      "id": "6wktakpuxqph",
      "type": "text",
      "x": 1200,
      "y": 540,
      "width": 480,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1016159586,
      "version": 1,
      "versionNonce": 1704533787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779446174776,
      "link": null,
      "locked": false,
      "text": "Slot dropout (regularizer)\n\nper sample, mask each slot ~ Bernoulli(1-p)\nrescale by 1/E[mask]\napplied BEFORE retrieval loss\n(decorrelation sees raw subs)\n\np = 0.15",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "ll4zklookep7",
      "originalText": "Slot dropout (regularizer)\n\nper sample, mask each slot ~ Bernoulli(1-p)\nrescale by 1/E[mask]\napplied BEFORE retrieval loss\n(decorrelation sees raw subs)\n\np = 0.15",
      "lineHeight": 1.25
    },
    {
      "id": "62gdswm31yih",
      "type": "text",
      "x": 160,
      "y": 700,
      "width": 1520,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
