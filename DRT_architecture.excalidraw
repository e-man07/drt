    {
      "id": "zcotohp6vz41",
      "type": "text",
      "x": 1020,
      "y": 840,
      "width": 780,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
