    },
    {
      "id": "qk2iagl58kxo",
      "type": "text",
      "x": 160,
      "y": 540,
      "width": 480,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2107002899,
      "version": 1,
      "versionNonce": 1811748551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779446174776,
      "link": null,
      "locked": false,
      "text": "L_retrieval (InfoNCE)\n\nfor each query q in batch B:\n   pos = DRT score with positive doc\n   negs = scores with in-batch + BM25 hard\n   cross-entropy(logits/\u03c4, target=0)\n\n\u03c4 = 0.05",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "0l7253j2d54i",
      "originalText": "L_retrieval (InfoNCE)\n\nfor each query q in batch B:\n   pos = DRT score with positive doc\n   negs = scores with in-batch + BM25 hard\n   cross-entropy(logits/\u03c4, target=0)\n\n\u03c4 = 0.05",
      "lineHeight": 1.25
    },
    {
      "id": "t7e8g8jdp0lv",
      "type": "rectangle",
      "x": 680,
      "y": 540,
      "width": 480,
      "height": 130,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1098272663,
      "version": 1,
      "versionNonce": 248347437,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "nujza7tz0ync",
          "type": "text"
        }
      ],
      "updated": 1779446174776,
      "link": null,
      "locked": false
    },
    {
      "id": "nujza7tz0ync",
      "type": "text",
      "x": 680,
      "y": 540,
      "width": 480,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1426439563,
      "version": 1,
      "versionNonce": 1977340355,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779446174776,
      "link": null,
      "locked": false,
      "text": "L_decorrelation (Barlow Twins)\n\nfor all pairs (i,j), i<j:\n   C[i,j] = sub[:,i]\u1d40 sub[:,j] / B   (d\u00d7d)\n   penalty += \u2016C[i,j]\u2016\u00b2_F\nloss = mean over pairs\n\n\u03bb_dec = 0.1",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "t7e8g8jdp0lv",
      "originalText": "L_decorrelation (Barlow Twins)\n\nfor all pairs (i,j), i<j:\n   C[i,j] = sub[:,i]\u1d40 sub[:,j] / B   (d\u00d7d)\n   penalty += \u2016C[i,j]\u2016\u00b2_F\nloss = mean over pairs\n\n\u03bb_dec = 0.1",
      "lineHeight": 1.25
    },
    {
      "id": "ll4zklookep7",
      "type": "rectangle",
      "x": 1200,
      "y": 540,
      "width": 480,
      "height": 130,
      "angle": 0,
      "strokeColor": "#e03131",
