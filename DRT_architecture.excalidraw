      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 52453128,
      "version": 1,
      "versionNonce": 99243209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779446174776,
      "link": null,
      "locked": false,
      "text": "L_total  =  L_retrieval  +  0.1 \u00b7 L_decorrelation       (slot dropout applied as structural regularizer)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 15,
      "containerId": null,
      "originalText": "L_total  =  L_retrieval  +  0.1 \u00b7 L_decorrelation       (slot dropout applied as structural regularizer)",
      "lineHeight": 1.25
    },
