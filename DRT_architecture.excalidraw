      "lineHeight": 1.25
    },
    {
      "id": "qtl3q4n89qkn",
      "type": "rectangle",
      "x": 160,
      "y": 2350,
      "width": 2240,
      "height": 230,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
